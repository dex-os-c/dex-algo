# ==============================================================================
# Dex Algo - Production Quantitative Trading Environment Configuration
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# If API keys are left blank, the bot automatically activates High-Fidelity
# Mock Mode (simulated paper trading) with realistic noise and latency for safe testing.
# ==============================================================================

# ------------------------------------------------------------------------------
# Alpaca Markets API Credentials (Stocks + Crypto Paper Trading)
# Obtain free paper keys at: https://app.alpaca.markets/paper/dashboard/overview
# ------------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# ------------------------------------------------------------------------------
# Optional Crypto Futures Credentials (Binance / Bybit for L2 & Funding Rates)
# ------------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# ------------------------------------------------------------------------------
# Quantitative Portfolio & Risk Management Parameters
# ------------------------------------------------------------------------------
# Target portfolio annualized volatility (0.15 = 15% vol targeting)
TARGET_ANNUAL_VOL=0.15

# Fractional Kelly sizing multiplier (0.5 = Half-Kelly, 0.25 = Quarter-Kelly)
KELLY_FRACTION=0.50

# Maximum single position allocation (0.20 = 20% equity cap)
MAX_SINGLE_POSITION_PCT=0.20

# Daily loss circuit breaker threshold (0.025 = 2.5% max daily drawdown)
MAX_DAILY_DRAWDOWN_PCT=0.025

# Maximum concurrent open positions permitted in the portfolio
MAX_POSITIONS=6

# Dynamic Chandelier trailing stop ATR multiplier
CHANDELIER_ATR_MULTIPLIER=3.0

# Active universe to scan and trade
TRADING_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,SPY,QQQ,AAPL,MSFT,NVDA

# ------------------------------------------------------------------------------
# Execution Engine & Server Settings
# ------------------------------------------------------------------------------
# Polling / event loop cycle interval in seconds
POLL_INTERVAL_SECONDS=5

# Force simulated paper trading mode (true/false)
MOCK_MODE=true

# Web Dashboard Server Bindings
HOST=0.0.0.0
PORT=8000
