# ==============================================================================
# Alpaca Quantitative Trading Bot - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# If ALPACA_API_KEY or ALPACA_SECRET_KEY are left blank, the bot automatically
# activates High-Fidelity Mock Mode (synthetic paper trading) for safe testing.
# ==============================================================================

# ------------------------------------------------------------------------------
# Alpaca Markets API Credentials (Paper Trading)
# Obtain your free paper keys at: https://app.alpaca.markets/paper/dashboard/overview
# ------------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# Alpaca Paper Trading REST endpoint (Default: https://paper-api.alpaca.markets)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpaca Market Data v2 endpoint (Default: https://data.alpaca.markets/v2)
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# ------------------------------------------------------------------------------
# Portfolio & Risk Management Parameters
# ------------------------------------------------------------------------------
# Maximum fractional portfolio equity risked on any single trade (0.01 = 1%)
RISK_PER_TRADE_PCT=0.01

# Maximum concurrent open positions permitted in the portfolio
MAX_POSITIONS=5

# Comma-separated list of ticker symbols to scan and trade
TRADING_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ

# ------------------------------------------------------------------------------
# Quantitative Strategy Parameters (EMA Trend + RSI Momentum + ATR Channel)
# ------------------------------------------------------------------------------
# Exponential Moving Average periods
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21

# Relative Strength Index (RSI) settings
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0

# Average True Range (ATR) & Dynamic Bracket Multipliers
ATR_PERIOD=14
# Stop Loss distance: Entry - (ATR * ATR_MULTIPLIER)
ATR_MULTIPLIER=2.0
# Take Profit distance: Entry + (ATR * TAKE_PROFIT_MULTIPLIER)
TAKE_PROFIT_MULTIPLIER=3.0

# ------------------------------------------------------------------------------
# Execution Engine & Server Settings
# ------------------------------------------------------------------------------
# Bot loop scan interval in seconds
POLL_INTERVAL_SECONDS=30

# Force synthetic mock mode (true/false).
# When true or when keys are absent, simulated paper trading runs locally.
MOCK_MODE=false

# Web Dashboard Server Bindings
HOST=0.0.0.0
PORT=8000
